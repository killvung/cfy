# Project URL from Settings > API Keys / Connect
SUPABASE_URL=https://your-project.supabase.co

# Backend Data API key (Settings > API Keys). Prefer a secret key:
#   sb_secret_...
# Legacy service_role JWTs still work until you disable them (deprecated end of 2026).
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# Optional: only needed to apply schema remotely via scripts/migrate_remote.py
# Create at https://supabase.com/dashboard/account/tokens (starts with sbp_)
# SUPABASE_ACCESS_TOKEN=sbp_your-personal-access-token
# SUPABASE_PROJECT_REF=your-project-ref

# Optional: HF bucket resolve base for relative storage_url values (Space default is set in images.py)
# IMAGE_BUCKET_BASE=https://huggingface.co/buckets/killvung/cat-feedback-assets/resolve
# IMAGE_BUCKET_MOUNT=/data
